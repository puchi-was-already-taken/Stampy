  object qUpdateHours: TFDQuery
    Connection = DB
    SQL.Strings = (
      'update Hours'
      'set Day = :Day,'
      '    TimeStamp = :TimeStamp,'
      '    Type = :Type,'
      '    FirstOfDay = :FirstOfDay'
      'where rowid = :rowid')
    Left = 289
    Top = 209
    ParamData = <
      item
        Name = 'DAY'
        ParamType = ptInput
      end
      item
        Name = 'TIMESTAMP'
        ParamType = ptInput
