  object qInsertHours: TFDQuery
    Connection = DB
    SQL.Strings = (
      'insert into Hours'
      '(Day, TimeStamp, FirstOfDay, Type, Note)'
      'values'
      '(:Day, :TimeStamp, :FirstOfDay, :Type, :Note)')
    Left = 344
    Top = 104
    ParamData = <
      item
        Name = 'DAY'
        ParamType = ptInput
      end
      item
        Name = 'TIMESTAMP'
        ParamType = ptInput
      end
      item
        Name = 'FIRSTOFDAY'
        ParamType = ptInput
      end
      item
        Name = 'TYPE'
        ParamType = ptInput
      end
      item
        Name = 'NOTE'
        ParamType = ptInput
      end>
  end
  object qFirstOfDay: TFDQuery
    Connection = DB
    SQL.Strings = (
      'select *'
      'from Hours'
      'where Day = :Day'
      '  and FirstOfDay = :FirstOfDay')
    Left = 184
    Top = 208
    ParamData = <
      item
        Name = 'DAY'
        ParamType = ptInput
      end
      item
        Name = 'FIRSTOFDAY'
        ParamType = ptInput
      end>
  end
  object qLastTypeOfDay: TFDQuery
    Connection = DB
    SQL.Strings = (
      'select Type'
      'from Hours'
      'where Day = :Day'
      'order by rowid desc'
      'limit 1')
    Left = 352
    Top = 152
    ParamData = <
      item
        Name = 'DAY'
        ParamType = ptInput
      end>
  end
  object qOptions: TFDQuery
    Connection = DB
    SQL.Strings = (
      'select *'
      'from Options')
    Left = 225
    Top = 256
  end
  object qReplaceOptions: TFDQuery
    Connection = DB
    SQL.Strings = (
      'replace into Options'
      '(Key, Value)'
      'values'
      '(:Key, :Value)')
    Left = 361
    Top = 256
    ParamData = <
      item
        Name = 'KEY'
        ParamType = ptInput
      end
      item
        Name = 'VALUE'
        ParamType = ptInput
      end>
  end
  object qTabelCount: TFDQuery
    Connection = DB
    SQL.Strings = (
      'SELECT count(*)'
      'FROM sqlite_master'
      'WHERE type = '#39'table'#39
      '  AND name != '#39'android_metadata'#39
      '  AND name != '#39'sqlite_sequence'#39';')
    Left = 89
    Top = 208
  end
  object qDay: TFDQuery
    Connection = DB
    SQL.Strings = (
      'select rowid, *'
      'from Hours'
      'where Day = :Day'
      'order by TimeStamp, rowid')
    Left = 233
    Top = 208
    ParamData = <
      item
        Name = 'DAY'
        ParamType = ptInput
      end>
  end
